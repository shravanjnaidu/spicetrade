# Flask backend URL (used by Next.js rewrites in next.config.js - server side only)
FLASK_API_URL=http://localhost:5000

# Public API base URL for client-side fetch calls
# Leave empty to use Next.js rewrites (recommended for same-host deployment)
# Set to http://localhost:5000 if running frontend and backend on different ports during dev
NEXT_PUBLIC_API_URL=
