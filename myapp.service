[Unit]
Description=BigSpice App Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/spicetrade

# Flask via Gunicorn (binds port 3000 per gunicorn.conf.py default)
ExecStart=/root/spicetrade/ENV/bin/gunicorn -c gunicorn.conf.py app:app

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target