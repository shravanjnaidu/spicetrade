[Unit]
Description=BigSpice App Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/spicetrade

# Activate the project virtualenv before starting Gunicorn.
ExecStart=/bin/bash -lc 'source ENV/bin/activate && exec gunicorn -c gunicorn.conf.py app:app'

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target