[Unit]
Description=BigSpice App Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/spicetrade
Environment=HOME=/root

# Run the existing startup script with the same shell startup files a manual
# root shell typically uses so npm/node and the virtualenv resolve correctly.
ExecStart=/bin/bash -lc 'source /root/.bash_profile 2>/dev/null || true; source /root/.bashrc 2>/dev/null || true; cd /root/spicetrade && exec ./start.sh'

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target