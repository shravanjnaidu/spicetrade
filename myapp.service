[Unit]
Description=BigSpice App Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/spicetrade

# Flask via Gunicorn
ExecStart=/root/ENV/bin/gunicorn -c gunicorn.conf.py app:app
Environment=PORT=5000

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target